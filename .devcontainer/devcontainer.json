{
  "name": "SuperKart Deployment",
  "build": {"dockerfile": "Dockerfile"},
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [7860, 8501],
  "portsAttributes": {
    "7860": {"label": "SuperKart API", "onAutoForward": "silent"},
    "8501": {"label": "SuperKart UI", "onAutoForward": "openBrowser"}
  },
  "postCreateCommand": "docker compose up --build -d --wait",
  "shutdownAction": "stopContainer"
}
